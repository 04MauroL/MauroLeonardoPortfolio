<MudAppBar Fixed="false" Gutters="false" Elevation="0">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
        <MudStack Spacing="5" AlignItems="AlignItems.Center" Row="true">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@AppRoutes.HomeUrl">
                <MudText Typo="Typo.h5">
                    <b>Mauro Leonardo</b>
                </MudText>
            </MudButton>

            <MudSpacer/>

            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <NavigationLink Href="@AppRoutes.HomeUrl">Home</NavigationLink>
                <NavigationLink Href="@AppRoutes.AboutUrl">About me</NavigationLink>
                <NavigationLink Href="@AppRoutes.SkillsetUrl">Skillset</NavigationLink>
                <NavigationLink Href="@AppRoutes.InternshipsUrl">Internships</NavigationLink>
                <NavigationLink Href="@AppRoutes.ProjectsUrl">Projects</NavigationLink>

                <MudDivider Vertical="true" DividerType="DividerType.Middle" FlexItem="true" Class="my-2"/>

                <MudIconButton Size="Size.Large" Icon="@Icons.Custom.Brands.GitHub" href="https://github.com/04MauroL" Target="_blank"/>
                <MudIconButton Size="Size.Large" Icon="@Icons.Custom.Brands.LinkedIn" href="https://www.linkedin.com/in/mauro-leonardo-8125282b7/" Target="_blank"/>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudMenu Icon="@Icons.Material.Filled.Menu"
                         DropShadow="false"
                         TransformOrigin="Origin.TopLeft">
                    <MudMenuItem Icon="@Icons.Material.Filled.Home" IconColor="Color.Primary" Label="Home"
                                 Href="@AppRoutes.HomeUrl"/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary" Label="About"
                                 Href="@AppRoutes.AboutUrl"/>
                    <MudMenuItem Icon="@Icons.Material.Filled.WorkspacePremium" IconColor="Color.Primary"
                                 Label="Skillset" Href="@AppRoutes.SkillsetUrl"/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Work" IconColor="Color.Primary" Label="Internships"
                                 Href="@AppRoutes.InternshipsUrl"/>
                    <MudMenuItem Icon="@Icons.Material.Filled.FolderShared" IconColor="Color.Primary" Label="Projects"
                                 Href="@AppRoutes.ProjectsUrl"/>

                    <MudDivider DividerType="DividerType.Middle" FlexItem="true" Class="my-2"/>

                    <MudMenuItem Icon="@Icons.Custom.Brands.GitHub" IconColor="Color.Primary" Label="GitHub" Href="https://github.com/04MauroL" Target="_blank"/>
                    <MudMenuItem Icon="@Icons.Custom.Brands.LinkedIn" IconColor="Color.Primary" Label="LinkedIn"
                                 Href="https://www.linkedin.com/in/mauro-leonardo-8125282b7/" Target="_blank"/>
                </MudMenu>
            </MudHidden>
        </MudStack>
    </MudContainer>
</MudAppBar>