@inherits LayoutComponentBase

<MudPopoverProvider/>
<MudThemeProvider Theme="_theme"/>

<MudLayout Class="d-flex flex-column mud-height-full">
    <NavigationComponent/>

    <MudMainContent Class="flex-grow-1 pa-0 py-md-20">
        @Body

        <MudScrollToTop TopOffset="100">
            <MudIconButton Variant="Variant.Filled" Icon="@Icons.Material.Filled.ArrowUpward"
                           Color="Color.Primary"/>
        </MudScrollToTop>
    </MudMainContent>

    <FooterComponent/>
</MudLayout>