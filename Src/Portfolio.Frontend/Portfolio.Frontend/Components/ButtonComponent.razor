<MudButton Variant="@Variant"
           Color="@Color"
           DropShadow="false"
           Class="px-6 py-4 rounded-pill"
           FullWidth="@FullWidth"
           Href="@Href"
           Target="@Target">
    <MudText Typo="Typo.h6" Color="@TextColor">
        @ChildContent
    </MudText>
</MudButton>