<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all"/>
        <PackageReference Include="MudBlazor" Version="9.5.0" GeneratePathProperty="true"/>
    </ItemGroup>

    <!-- Auto-copy MudBlazor CSS to wwwroot for IDE Intellisense -->
    <Target Name="CopyMudBlazorCss" BeforeTargets="Build">
        <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot/css"/>
        <Copy SourceFiles="$(PkgMudBlazor)/staticwebassets/MudBlazor.min.css"
              DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/css/mudblazor-intellisense.css"
              SkipUnchangedFiles="true"/>
    </Target>

    <ItemGroup>
        <Folder Include="wwwroot\files\"/>
        <Folder Include="wwwroot\images\home\"/>
        <Folder Include="wwwroot\images\projects\hotel-kempenrust\"/>
        <Folder Include="wwwroot\images\skillset\"/>
    </ItemGroup>

</Project>
