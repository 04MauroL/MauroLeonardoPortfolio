@page "/project/{ProjectName}"
@using Portfolio.Frontend.Components

<MudStack Spacing="10">
    <Section>
        <MudStack Spacing="5" AlignItems="AlignItems.Center">
            <SectionTitle>@ProjectInfoDetails.Title</SectionTitle>
            <MudText Typo="Typo.h5" Align="Align.Center">
                @ProjectInfoDetails.Description
            </MudText>
        </MudStack>
    </Section>

    <MudSpacer/>

    <Section>
        <MudGrid Spacing="20" Justify="Justify.SpaceAround" Class="mud-tertiary-text">
            <MudItem xs="12" md="5">
                <MudStack Spacing="20">
                    @foreach (var page in ProjectInfoDetails.PageDetails)
                    {
                        <Section BackgroundColor="Color.Primary" Class="rounded-xl">
                            <MudStack Spacing="20">
                                <MudStack Spacing="10">
                                    <SectionTitle>
                                        @(page.Title)
                                    </SectionTitle>
                                    <MudText Typo="Typo.h5">
                                        @(page.Description)
                                    </MudText>
                                </MudStack>

                                <MudImage Src="@(page.ImageSrc)"
                                          Alt="@(page.ImageAlt)"
                                          Elevation="3"
                                          Fluid="true"
                                          Class="rounded-xl"/>
                            </MudStack>
                        </Section>

                        <MudSpacer/>
                    }
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudStack Spacing="20">

                    <MudSpacer/>
                    @foreach (var page in ProjectInfoDetails.PageDetails)
                    {
                        <MudSpacer/>

                        <Section BackgroundColor="Color.Primary" Class="rounded-xl">
                            <MudStack Spacing="20">
                                <MudStack Spacing="10">
                                    <SectionTitle>
                                        @(page.Title)
                                    </SectionTitle>
                                    <MudText Typo="Typo.h5">
                                        @(page.Description)
                                    </MudText>
                                </MudStack>

                                <MudImage Src="@(page.ImageSrc)"
                                          Alt="@(page.ImageAlt)"
                                          Elevation="3"
                                          Fluid="true"
                                          Class="rounded-xl"/>
                            </MudStack>
                        </Section>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section>
        <MudStack Spacing="20">
            @foreach (var stack in ProjectInfoDetails.TechStackDetails)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudStack Spacing="5">
                        <SectionSubTitle>@(stack.Title)</SectionSubTitle>
                        <MudText>
                            @(stack.Description)
                        </MudText>
                    </MudStack>
                    <MudImage Src="@(stack.ImageSrc)"
                              Alt="@(stack.ImageAlt)"
                              Fluid="true"
                              Width="200"/>
                </MudStack>
            }
        </MudStack>
    </Section>

    <MudSpacer/>

    <Section>
        <MudStack Spacing="10" AlignItems="AlignItems.Start" Class="mud-width-full">
            <MudText Typo="Typo.h5" Align="Align.Start">
                If you have any questions about my projects, or want to work on one together, make sure to reach out!
            </MudText>
            <MudStack Class="flex-column flex-md-row mud-width-full">
                <ButtonComponent Variant="Variant.Filled" TextColor="Color.Tertiary" Href="@AppRoutes.ContactUrl">
                    Contact me here!
                </ButtonComponent>
                <ButtonComponent Variant="Variant.Filled" TextColor="Color.Tertiary" Href="@AppRoutes.SkillsetUrl">
                    View my skillset here!
                </ButtonComponent>
            </MudStack>
        </MudStack>
    </Section>
</MudStack>
