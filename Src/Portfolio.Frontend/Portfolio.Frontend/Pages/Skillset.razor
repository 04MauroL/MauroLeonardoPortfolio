@page "/skillset"
@using Portfolio.Frontend.Components

<MudStack Spacing="20">
    <Section>
        <MudGrid Spacing="10" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6">
                <MudImage Src="images/skillset/Figma-Editor.png"
                          Alt="Figma Editor"
                          Fluid="true"
                          Class="mud-width-full rounded-lg"/>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="10">
                    <SectionTitle>
                        The Core of Design
                    </SectionTitle>

                    <MudText Typo="Typo.h5">
                        Creating designs before starting to code is the key for building good websites. Using UI/UX
                        tactics
                        & Figma, I can build prototypes for websites before actually creating them.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>HTML.</SectionSubTitle>
                        HTML is what builds the layout of websites. I use it to shape your website, place whatever you
                        want
                        wherever you want it. It is the core of all websites.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>CSS.</SectionSubTitle>
                        Without colours and styling, a website will not attract anyone. With CSS you can style HTML, and
                        create the user interface of your website.
                    </MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>

    <Section BackgroundColor="Color.Primary">
        <MudGrid Spacing="10" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6" Class="mud-text-tertiary">
                <MudStack Spacing="10">
                    <SectionTitle Color="Color.Tertiary">
                        Where Design Meets Function
                    </SectionTitle>

                    <MudText Typo="Typo.h5" Color="Color.Tertiary">
                        Static websites work, but websites with interactive components, animations and fun interactions
                        are the future of web development.
                    </MudText>

                    <MudText Typo="Typo.h5" Color="Color.Tertiary">
                        <SectionSubTitle>JavaScript.</SectionSubTitle>
                        With JavaScript I animate components and make them interactive.
                    </MudText>

                    <MudText Typo="Typo.h5" Color="Color.Tertiary">
                        <SectionSubTitle>TypeScript.</SectionSubTitle>
                        TypeScript is a superset of JavaScript. I use this for bigger projects, backends, but also for
                        animating and providing motion to websites.
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudImage Src="images/skillset/Edit-Swim-Lesson-Modal.png"
                          Alt="Modal for editing swim lesson"
                          Fluid="true"
                          Class="mud-width-full rounded-lg"/>
            </MudItem>
        </MudGrid>
    </Section>

    <Section>
        <MudGrid Spacing="20" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6">
                <MudStack Spacing="10" AlignItems="AlignItems.Center">
                    <SectionTitle>
                        Frameworks to Speed Up Design
                    </SectionTitle>

                    <MudText Typo="Typo.h5" Align="Align.Center">
                        Creating websites with plain HTML, CSS & JavaScript make for fast & lightweight websites, but
                        take a long time to build. Frameworks solve this problem.
                    </MudText>

                    <MudImage Src="images/skillset/Sponsor-Site.png"
                              Alt="Figma Editor"
                              Fluid="true"
                              Class="mud-width-full rounded-lg"/>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="10" AlignItems="AlignItems.Center">
                    <MudImage Src="images/skillset/Backend1.png"
                              Alt="Figma Editor"
                              Fluid="true"
                              Class="mud-width-full rounded-lg"/>

                    <SectionTitle>
                        Frameworks for Scalable API's
                    </SectionTitle>

                    <MudText Typo="Typo.h5" Align="Align.Center">
                        Frameworks like node.js, ASP.NET Core and Laravel help me design robust and scalable API's, both
                        REST API's or application specific/focused.
                    </MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>
</MudStack>