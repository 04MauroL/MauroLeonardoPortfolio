@page "/skillset"
@using Portfolio.Frontend.Components

<MudStack Spacing="20">
    <Section>
        <MudGrid Spacing="20" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6" Class="order-md-first order-last">
                <MudImage Src="images/skillset/Figma-Editor.png"
                          Alt="Figma Editor"
                          Elevation="3"
                          Fluid="true"
                          Class="mud-width-full rounded-lg"/>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="10">
                    <SectionTitle>
                        The Core of Design
                    </SectionTitle>

                    <MudText Typo="Typo.h5">
                        Creating designs before starting to code is the key for building good websites. Using UI/UX
                        tactics
                        & Figma, I can build prototypes for websites before actually creating them.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>HTML.</SectionSubTitle>
                        HTML is what builds the layout of websites. I use it to shape your website, place whatever you
                        want
                        wherever you want it. It is the core of all websites.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>CSS.</SectionSubTitle>
                        Without colours and styling, a website will not attract anyone. With CSS you can style HTML, and
                        create the user interface of your website.
                    </MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section BackgroundColor="Color.Primary" Class="mud-tertiary-text">
        <MudGrid Spacing="20" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6" Class="mud-text-tertiary">
                <MudStack Spacing="10">
                    <SectionTitle>
                        Where Design Meets Function
                    </SectionTitle>

                    <MudText Typo="Typo.h5">
                        Static websites work, but websites with interactive components, animations and fun interactions
                        are the future of web development.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>JavaScript.</SectionSubTitle>
                        With JavaScript I animate components and make them interactive.
                    </MudText>

                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>TypeScript.</SectionSubTitle>
                        TypeScript is a superset of JavaScript. I use this for bigger projects, backends, but also for
                        animating and providing motion to websites.
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudImage Src="images/skillset/Edit-Swim-Lesson-Modal.png"
                          Alt="Modal for editing swim lesson"
                          Elevation="3"
                          Fluid="true"
                          Class="mud-width-full rounded-lg"/>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section>
        <MudGrid Spacing="20" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6">
                <MudStack Spacing="10" AlignItems="AlignItems.Center">
                    <SectionTitle Center="true">
                        Frameworks to Speed Up Design
                    </SectionTitle>

                    <MudText Typo="Typo.h5" Align="Align.Center">
                        Creating websites with plain HTML, CSS & JavaScript make for fast & lightweight websites, but
                        take a long time to build. Frameworks solve this problem.
                    </MudText>

                    <MudImage Src="images/skillset/Sponsor-Site.png"
                              Alt="Figma Editor"
                              Elevation="3"
                              Fluid="true"
                              Class="mud-width-full rounded-lg"/>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="10" AlignItems="AlignItems.Center">
                    <MudImage Src="images/skillset/Backend1.png"
                              Alt="Backend code 1"
                              Elevation="3"
                              Fluid="true"
                              Class="mud-width-full rounded-lg order-md-first order-last"/>

                    <SectionTitle Center="true">
                        Frameworks for Scalable API's
                    </SectionTitle>

                    <MudText Typo="Typo.h5" Align="Align.Center">
                        Frameworks like node.js, ASP.NET Core and Laravel help me design robust and scalable API's, both
                        REST API's or application specific.
                    </MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section>
        <MudGrid Spacing="20">
            <MudItem xs="12" md="6">
                <Section BackgroundColor="Color.Primary" Class="mud-tertiary-text rounded-xl">
                    <MudStack Spacing="10" AlignItems="AlignItems.Center" Class="flex-md-row">
                        <MudImage Src="images/skillset/Angular-Logo.png"
                                  Alt="Angular Logo"
                                  Fluid="true"
                                  Width="300"
                                  Class="mud-theme-tertiary rounded-xl"/>

                        <MudText Typo="Typo.h5">
                            <SectionSubTitle>Angular.</SectionSubTitle>
                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ad aut commodi consequatur ducimus
                            ea est in ipsam ipsum laudantium nisi nulla omnis pariatur quaerat sed sint sunt totam
                            velit, veniam!
                        </MudText>
                    </MudStack>
                </Section>
            </MudItem>

            <MudItem xs="12" md="6">
                <Section BackgroundColor="Color.Primary" Class="mud-tertiary-text rounded-xl">
                    <MudStack Spacing="10" AlignItems="AlignItems.Center" Class="flex-md-row">
                        <MudImage Src="images/skillset/Blazor-Logo.png"
                                  Alt="Blazor Logo"
                                  Fluid="true"
                                  Width="300"
                                  Class="order-md-last mud-theme-tertiary rounded-xl"/>

                        <MudText Typo="Typo.h5">
                            <SectionSubTitle>Blazor.</SectionSubTitle>
                            A frontend framework developed by Microsoft, build on ASP.NET Core, providing the ability to
                            create reusable components, and use C# instead of JS for logic programming.
                        </MudText>
                    </MudStack>
                </Section>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section>
        <MudGrid Spacing="20">
            <MudItem xs="12" md="6">
                <MudStack Spacing="10" AlignItems="AlignItems.Center" Class="flex-grow-1">
                    <MudText Typo="Typo.h5">
                        <SectionSubTitle>ASP.NET Core back-ends.</SectionSubTitle>
                        I’ve created multiple back-ends using ASP.NET Core, an open-source multi platform framework
                        created by Microsoft.
                    </MudText>

                    <MudImage Src="images/skillset/Backend2.png"
                              Alt="Backend code 2"
                              Elevation="3"
                              Fluid="true"
                              ObjectFit="ObjectFit.ScaleDown"
                              Class="rounded-xl order-md-last order-first"/>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6" Class="d-flex">
                <MudImage Src="images/skillset/Open-Api.png"
                          Alt="Open Api Example"
                          Elevation="3"
                          Fluid="true"
                          Class="rounded-xl"/>
            </MudItem>
        </MudGrid>
    </Section>

    <MudSpacer/>

    <Section BackgroundColor="Color.Primary" Class="mud-tertiary-text">
        <MudStack Spacing="10" AlignItems="AlignItems.Stretch" Style="width: max-content; margin: 0 auto;">
            <MudText Typo="Typo.h5" Align="Align.Center" Style="white-space: nowrap;">
                Take a look at my projects to see where I used my skills,<br/>
                and contact me for more information about what I use!
            </MudText>
            <MudStack Row="true">
                <ButtonComponent Variant="Variant.Filled" Color="Color.Tertiary" TextColor="Color.Dark">
                    View my projects!
                </ButtonComponent>
                <ButtonComponent Variant="Variant.Filled" Color="Color.Tertiary" TextColor="Color.Dark">
                    Contact me!
                </ButtonComponent>
            </MudStack>
        </MudStack>
    </Section>
</MudStack>

