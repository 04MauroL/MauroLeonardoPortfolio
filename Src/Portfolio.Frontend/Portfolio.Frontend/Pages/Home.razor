@page "/"
@using Portfolio.Frontend.Components

<MudStack Spacing="20">
    <Section BackgroundColor="Color.Primary">
        <MudGrid Spacing="20" Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="6" Class="d-flex order-2 order-md-1">
                <MudStack Spacing="10" Justify="Justify.Center" Class="mud-tertiary-text flex-grow-1">
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="align-md-start">Hi, I'm Mauro</MudText>
                    <MudText Typo="Typo.h2" Align="Align.Center" Class="align-md-start">
                        <b>Application Developer</b>
                    </MudText>
                    <MudText Typo="Typo.h4" Align="Align.Center" Class="align-md-start">Based in Herselt, Belgium
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6" Class="d-flex justify-center order-1 order-md-2">
                <MudImage Src="images/home/Mauro.jpg" Alt="Mauro Leonardo" Fluid="true" Width="500" Height="500"
                          Class="rounded-pill"/>
            </MudItem>
        </MudGrid>
    </Section>

    <Section>
        <MudGrid Spacing="20" Justify="Justify.SpaceAround" Class="my-md-20">
            <MudItem xs="12" md="5">
                <MudStack Spacing="6">
                    <MudText Typo="Typo.h4" Align="Align.Center">
                        <b>Get to know me!</b>
                    </MudText>

                    <MudStack Spacing="6" AlignItems="AlignItems.Center">
                        <MudImage Src="images/home/Passion.png"
                                  Alt="Passion"
                                  Elevation="0"
                                  Class="shadow-none rounded-xl"
                                  Fluid="true"/>
                        <MudText Typo="Typo.h6" Align="Align.Center">
                            <SectionSubTitle>Passion.</SectionSubTitle>
                            I thrive to create applications with a focus on user experience, leveraging years of coding
                            and programming experience.
                        </MudText>

                        <ButtonComponent Href="@AppRoutes.AboutUrl">Learn more about me!</ButtonComponent>
                    </MudStack>

                    <MudSpacer/>

                    <MudStack Spacing="6" AlignItems="AlignItems.Center">
                        <MudImage Src="images/home/Internships.png"
                                  Alt="Internships"
                                  Elevation="0"
                                  Class="shadow-none rounded-xl"
                                  Fluid="true"
                                  Width="450"
                                  Height="450"/>
                        <MudText Typo="Typo.h6" Align="Align.Center">
                            <SectionSubTitle>Internships.</SectionSubTitle>
                            To graduate my Associate Degree & Bachelor, I had to finish an internship. I chose AllPhi in
                            Westerlo for both my internships.
                        </MudText>

                        <ButtonComponent Href="@AppRoutes.InternshipsUrl">View my internships!</ButtonComponent>
                    </MudStack>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudStack Spacing="20">
                    <MudStack Spacing="6" AlignItems="AlignItems.Center">
                        <MudImage Src="images/home/Skillset.jpg" Alt="Skillset" Elevation="0"
                                  Class="shadow-none rounded-xl"
                                  Fluid="true"/>
                        <MudText Typo="Typo.h6" Align="Align.Center">
                            <SectionSubTitle>Skillset.</SectionSubTitle>
                            Creating delightful and enjoyable user interfaces and experiences requires the right tools
                            and a strong set of skills.
                        </MudText>

                        <ButtonComponent Href="@AppRoutes.SkillsetUrl">View my skillset!</ButtonComponent>
                    </MudStack>

                    <MudSpacer/>

                    <MudStack Spacing="6" AlignItems="AlignItems.Center">
                        <MudImage Src="images/home/Projects.png"
                                  Alt="Projects"
                                  Elevation="0"
                                  Class="shadow-none rounded-xl"
                                  Fluid="true"/>
                        <MudText Typo="Typo.h6" Align="Align.Center">
                            <SectionSubTitle>Projects.</SectionSubTitle>
                            During my Associate Degree & Bachelor, I have successfully created multiple projects, and
                            gained relevant skills in the field of IT.
                        </MudText>

                        <ButtonComponent Href="@AppRoutes.ProjectsUrl">View my projects!</ButtonComponent>
                    </MudStack>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Section>

</MudStack>
